+/* HARD FIX: Arena live preview centering + no sideways drift */
+@media (max-width: 1536px) {
+  /* MainAppLayout uses a desktop side Live Hub that can push content off-center inside Arena's narrow preview. */
+  main.max-w-\[1800px\],
+  main.max-w-\[1700px\] {
+    display: block !important;
+    width: 100% !important;
+    max-width: 100vw !important;
+    padding-left: clamp(0.75rem, 2.5vw, 1.25rem) !important;
+    padding-right: clamp(0.75rem, 2.5vw, 1.25rem) !important;
+    margin-left: auto !important;
+    margin-right: auto !important;
+    overflow-x: hidden !important;
