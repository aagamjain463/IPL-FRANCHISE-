# Gemini API Key for AI commentary, press conferences, and scouting features
GEMINI_API_KEY=
# Google Sign-In OAuth client ID.
# Create a Web OAuth client in Google Cloud Console and add your app origin.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Server-only secret used to sign cloud-save sessions. Never expose in browser code.
CLOUD_SAVE_SECRET=
# Optional file-backed development storage paths. Production can replace this with Supabase/Postgres.
CLOUD_SAVE_DATA_PATH=
LEADERBOARD_DATA_PATH=
